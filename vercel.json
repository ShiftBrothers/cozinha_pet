{
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.cozinhapets.com.br" }],
      "destination": "https://cozinhapets.com.br/:path",
      "permanent": true
    }
  ]
}
